[
    {
        "id": "cv-tab",
        "type": "ui_tab",
        "name": "Campervan",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "cv-group-battery",
        "type": "ui_group",
        "name": "Battery",
        "tab": "cv-tab",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "cv-group-solar",
        "type": "ui_group",
        "name": "Solar",
        "tab": "cv-tab",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "cv-group-ac",
        "type": "ui_group",
        "name": "AC Loads",
        "tab": "cv-tab",
        "order": 3,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "cv-mqtt-broker",
        "type": "mqtt-broker",
        "name": "Cerbo MQTT",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered-dashboard",
        "usetls": false,
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "cv-poll-timer",
        "type": "inject",
        "name": "Poll every 10s",
        "props": [{"p": "payload"}],
        "repeat": "10",
        "crontab": "",
        "once": true,
        "onceDelay": 2,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 140,
        "y": 40,
        "wires": [["cv-poll-func"]]
    },
    {
        "id": "cv-poll-func",
        "type": "function",
        "name": "Request all values",
        "func": "var topics = [\n    'R/c0619aba0c76/system/0/Dc/Battery/Soc',\n    'R/c0619aba0c76/system/0/Dc/Battery/Voltage',\n    'R/c0619aba0c76/system/0/Dc/Battery/Power',\n    'R/c0619aba0c76/system/0/Dc/Battery/Current',\n    'R/c0619aba0c76/system/0/Dc/Battery/Temperature',\n    'R/c0619aba0c76/system/0/Dc/Pv/Power',\n    'R/c0619aba0c76/system/0/Ac/Consumption/L1/Power'\n];\nvar msgs = topics.map(function(t) {\n    return {topic: t, payload: ''};\n});\nreturn [msgs];",
        "outputs": 1,
        "x": 360,
        "y": 40,
        "wires": [["cv-poll-out"]]
    },
    {
        "id": "cv-poll-out",
        "type": "mqtt out",
        "name": "Request",
        "topic": "",
        "qos": "0",
        "retain": "",
        "broker": "cv-mqtt-broker",
        "x": 550,
        "y": 40,
        "wires": []
    },
    {
        "id": "cv-soc-in",
        "type": "mqtt in",
        "name": "Battery SOC",
        "topic": "N/+/system/0/Dc/Battery/Soc",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 130,
        "y": 120,
        "wires": [["cv-soc-func"]]
    },
    {
        "id": "cv-soc-func",
        "type": "function",
        "name": "Extract SOC",
        "func": "msg.payload = parseFloat(msg.payload.value);\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 120,
        "wires": [["cv-soc-gauge", "cv-soc-chart"]]
    },
    {
        "id": "cv-soc-gauge",
        "type": "ui_gauge",
        "name": "Battery %",
        "group": "cv-group-battery",
        "order": 1,
        "width": "3",
        "height": "3",
        "gtype": "gage",
        "title": "Battery",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": "100",
        "colors": ["#CA3838", "#E6E600", "#00B500"],
        "seg1": "25",
        "seg2": "75",
        "className": "",
        "x": 530,
        "y": 100,
        "wires": []
    },
    {
        "id": "cv-soc-chart",
        "type": "ui_chart",
        "name": "Battery History",
        "group": "cv-group-battery",
        "order": 2,
        "width": "6",
        "height": "4",
        "label": "Battery %",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm",
        "interpolate": "linear",
        "nodata": "Waiting...",
        "dot": false,
        "ymin": "0",
        "ymax": "100",
        "removeOlder": "24",
        "removeOlderPoints": "",
        "removeOlderUnit": "3600",
        "cutout": 0,
        "useOneColor": true,
        "useUTC": false,
        "colors": ["#4682B4"],
        "outputs": 1,
        "useDifferentColor": false,
        "className": "",
        "x": 550,
        "y": 140,
        "wires": [[]]
    },
    {
        "id": "cv-voltage-in",
        "type": "mqtt in",
        "name": "Battery Voltage",
        "topic": "N/+/system/0/Dc/Battery/Voltage",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 140,
        "y": 200,
        "wires": [["cv-voltage-func"]]
    },
    {
        "id": "cv-voltage-func",
        "type": "function",
        "name": "Extract Voltage",
        "func": "msg.payload = parseFloat(msg.payload.value).toFixed(2) + 'V';\nreturn msg;",
        "outputs": 1,
        "x": 340,
        "y": 200,
        "wires": [["cv-voltage-text"]]
    },
    {
        "id": "cv-voltage-text",
        "type": "ui_text",
        "name": "Voltage",
        "group": "cv-group-battery",
        "order": 3,
        "width": "3",
        "height": "1",
        "label": "Voltage",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 540,
        "y": 200,
        "wires": []
    },
    {
        "id": "cv-power-in",
        "type": "mqtt in",
        "name": "Battery Power",
        "topic": "N/+/system/0/Dc/Battery/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 140,
        "y": 250,
        "wires": [["cv-power-func"]]
    },
    {
        "id": "cv-power-func",
        "type": "function",
        "name": "Extract Power",
        "func": "msg.payload = Math.round(msg.payload.value) + 'W';\nreturn msg;",
        "outputs": 1,
        "x": 340,
        "y": 250,
        "wires": [["cv-power-text"]]
    },
    {
        "id": "cv-power-text",
        "type": "ui_text",
        "name": "Power",
        "group": "cv-group-battery",
        "order": 4,
        "width": "3",
        "height": "1",
        "label": "Power",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 540,
        "y": 250,
        "wires": []
    },
    {
        "id": "cv-temp-in",
        "type": "mqtt in",
        "name": "Battery Temp",
        "topic": "N/+/system/0/Dc/Battery/Temperature",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 140,
        "y": 300,
        "wires": [["cv-temp-func"]]
    },
    {
        "id": "cv-temp-func",
        "type": "function",
        "name": "Extract Temp",
        "func": "msg.payload = parseFloat(msg.payload.value).toFixed(1) + '°C';\nreturn msg;",
        "outputs": 1,
        "x": 340,
        "y": 300,
        "wires": [["cv-temp-text"]]
    },
    {
        "id": "cv-temp-text",
        "type": "ui_text",
        "name": "Temperature",
        "group": "cv-group-battery",
        "order": 5,
        "width": "3",
        "height": "1",
        "label": "Temperature",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 540,
        "y": 300,
        "wires": []
    },
    {
        "id": "cv-solar-in",
        "type": "mqtt in",
        "name": "Solar Power",
        "topic": "N/+/system/0/Dc/Pv/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 130,
        "y": 380,
        "wires": [["cv-solar-func"]]
    },
    {
        "id": "cv-solar-func",
        "type": "function",
        "name": "Extract Solar",
        "func": "msg.payload = Math.round(msg.payload.value);\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 380,
        "wires": [["cv-solar-gauge", "cv-solar-chart"]]
    },
    {
        "id": "cv-solar-gauge",
        "type": "ui_gauge",
        "name": "Solar W",
        "group": "cv-group-solar",
        "order": 1,
        "width": "3",
        "height": "3",
        "gtype": "gage",
        "title": "Solar",
        "label": "W",
        "format": "{{value}}",
        "min": 0,
        "max": "3000",
        "colors": ["#555555", "#F5B800", "#00B500"],
        "seg1": "500",
        "seg2": "1500",
        "className": "",
        "x": 530,
        "y": 360,
        "wires": []
    },
    {
        "id": "cv-solar-chart",
        "type": "ui_chart",
        "name": "Solar History",
        "group": "cv-group-solar",
        "order": 2,
        "width": "6",
        "height": "4",
        "label": "Solar Power (W)",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm",
        "interpolate": "linear",
        "nodata": "Waiting...",
        "dot": false,
        "ymin": "0",
        "ymax": "",
        "removeOlder": "24",
        "removeOlderPoints": "",
        "removeOlderUnit": "3600",
        "cutout": 0,
        "useOneColor": true,
        "useUTC": false,
        "colors": ["#F5B800"],
        "outputs": 1,
        "useDifferentColor": false,
        "className": "",
        "x": 550,
        "y": 400,
        "wires": [[]]
    },
    {
        "id": "cv-acload-in",
        "type": "mqtt in",
        "name": "AC Load",
        "topic": "N/+/system/0/Ac/Consumption/L1/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 130,
        "y": 480,
        "wires": [["cv-acload-func"]]
    },
    {
        "id": "cv-acload-func",
        "type": "function",
        "name": "Extract AC",
        "func": "msg.payload = Math.round(msg.payload.value) + 'W';\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 480,
        "wires": [["cv-acload-text"]]
    },
    {
        "id": "cv-acload-text",
        "type": "ui_text",
        "name": "AC Load",
        "group": "cv-group-ac",
        "order": 1,
        "width": "3",
        "height": "1",
        "label": "AC Load",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 530,
        "y": 480,
        "wires": []
    }
]
