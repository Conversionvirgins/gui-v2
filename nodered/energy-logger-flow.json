[
    {
        "id": "log-mqtt-broker",
        "type": "mqtt-broker",
        "name": "Cerbo MQTT",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered-logger",
        "usetls": false,
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "log-tab",
        "type": "ui_tab",
        "name": "Energy Log",
        "icon": "dashboard",
        "order": 2
    },
    {
        "id": "log-group-daily",
        "type": "ui_group",
        "name": "Daily Summary",
        "tab": "log-tab",
        "order": 1,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "log-group-power",
        "type": "ui_group",
        "name": "Power History",
        "tab": "log-tab",
        "order": 2,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "log-solar-in",
        "type": "mqtt in",
        "name": "Solar Power",
        "topic": "N/+/system/0/Dc/Pv/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "log-mqtt-broker",
        "x": 130,
        "y": 80,
        "wires": [["log-solar-func"]]
    },
    {
        "id": "log-solar-func",
        "type": "function",
        "name": "Track Solar Energy",
        "func": "var power = parseFloat(msg.payload.value);\nif (isNaN(power)) return null;\n\nvar now = new Date();\nvar today = now.toISOString().split('T')[0];\nvar lastDay = flow.get('solarDay') || '';\nvar totalWh = flow.get('solarTotalWh') || 0;\nvar lastTime = flow.get('solarLastTime') || now.getTime();\n\n// Reset at midnight\nif (today !== lastDay) {\n    var yesterdayTotal = totalWh;\n    flow.set('solarYesterdayKwh', (yesterdayTotal / 1000).toFixed(2));\n    totalWh = 0;\n    flow.set('solarDay', today);\n}\n\n// Accumulate energy (power * time in hours)\nvar elapsed = (now.getTime() - lastTime) / 3600000; // hours\nif (elapsed > 0 && elapsed < 0.1) { // max 6 min gap\n    totalWh += power * elapsed;\n}\nflow.set('solarTotalWh', totalWh);\nflow.set('solarLastTime', now.getTime());\n\nvar todayKwh = (totalWh / 1000).toFixed(2);\nflow.set('solarTodayKwh', todayKwh);\n\nreturn [\n    {payload: todayKwh + ' kWh'},\n    {payload: power}\n];",
        "outputs": 2,
        "x": 340,
        "y": 80,
        "wires": [["log-solar-today"], ["log-power-chart"]]
    },
    {
        "id": "log-solar-today",
        "type": "ui_text",
        "name": "Solar Today",
        "group": "log-group-daily",
        "order": 1,
        "width": "4",
        "height": "1",
        "label": "Solar Today",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 560,
        "y": 60,
        "wires": []
    },
    {
        "id": "log-battery-in",
        "type": "mqtt in",
        "name": "Battery Power",
        "topic": "N/+/system/0/Dc/Battery/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "log-mqtt-broker",
        "x": 130,
        "y": 180,
        "wires": [["log-battery-func"]]
    },
    {
        "id": "log-battery-func",
        "type": "function",
        "name": "Track Battery Energy",
        "func": "var power = parseFloat(msg.payload.value);\nif (isNaN(power)) return null;\n\nvar now = new Date();\nvar today = now.toISOString().split('T')[0];\nvar lastDay = flow.get('battDay') || '';\nvar chargedWh = flow.get('battChargedWh') || 0;\nvar dischargedWh = flow.get('battDischargedWh') || 0;\nvar lastTime = flow.get('battLastTime') || now.getTime();\n\nif (today !== lastDay) {\n    chargedWh = 0;\n    dischargedWh = 0;\n    flow.set('battDay', today);\n}\n\nvar elapsed = (now.getTime() - lastTime) / 3600000;\nif (elapsed > 0 && elapsed < 0.1) {\n    if (power > 0) {\n        chargedWh += power * elapsed;\n    } else {\n        dischargedWh += Math.abs(power) * elapsed;\n    }\n}\nflow.set('battChargedWh', chargedWh);\nflow.set('battDischargedWh', dischargedWh);\nflow.set('battLastTime', now.getTime());\n\nreturn [\n    {payload: (chargedWh / 1000).toFixed(2) + ' kWh'},\n    {payload: (dischargedWh / 1000).toFixed(2) + ' kWh'},\n    {payload: power}\n];",
        "outputs": 3,
        "x": 350,
        "y": 180,
        "wires": [["log-batt-charged"], ["log-batt-discharged"], ["log-power-chart"]]
    },
    {
        "id": "log-batt-charged",
        "type": "ui_text",
        "name": "Charged Today",
        "group": "log-group-daily",
        "order": 2,
        "width": "4",
        "height": "1",
        "label": "Charged",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 570,
        "y": 160,
        "wires": []
    },
    {
        "id": "log-batt-discharged",
        "type": "ui_text",
        "name": "Discharged Today",
        "group": "log-group-daily",
        "order": 3,
        "width": "4",
        "height": "1",
        "label": "Discharged",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 580,
        "y": 200,
        "wires": []
    },
    {
        "id": "log-acload-in",
        "type": "mqtt in",
        "name": "AC Load",
        "topic": "N/+/system/0/Ac/Consumption/L1/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "log-mqtt-broker",
        "x": 130,
        "y": 280,
        "wires": [["log-acload-func"]]
    },
    {
        "id": "log-acload-func",
        "type": "function",
        "name": "Extract AC",
        "func": "msg.payload = Math.round(parseFloat(msg.payload.value));\nmsg.topic = 'AC Load';\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 280,
        "wires": [["log-power-chart"]]
    },
    {
        "id": "log-power-chart",
        "type": "ui_chart",
        "name": "Power History",
        "group": "log-group-power",
        "order": 1,
        "width": "12",
        "height": "6",
        "label": "Power (W)",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm",
        "interpolate": "linear",
        "nodata": "Waiting for data...",
        "dot": false,
        "ymin": "",
        "ymax": "",
        "removeOlder": "6",
        "removeOlderPoints": "",
        "removeOlderUnit": "3600",
        "cutout": 0,
        "useOneColor": false,
        "useUTC": false,
        "colors": ["#F5B800", "#4682B4", "#E68E8A"],
        "outputs": 1,
        "useDifferentColor": false,
        "className": "",
        "x": 570,
        "y": 280,
        "wires": [[]]
    },
    {
        "id": "log-yesterday-inject",
        "type": "inject",
        "name": "Update yesterday",
        "props": [{"p": "payload"}],
        "repeat": "60",
        "crontab": "",
        "once": true,
        "onceDelay": 5,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 380,
        "wires": [["log-yesterday-func"]]
    },
    {
        "id": "log-yesterday-func",
        "type": "function",
        "name": "Get Yesterday Solar",
        "func": "var yesterdayKwh = flow.get('solarYesterdayKwh') || '0';\nmsg.payload = yesterdayKwh + ' kWh';\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 380,
        "wires": [["log-yesterday-text"]]
    },
    {
        "id": "log-yesterday-text",
        "type": "ui_text",
        "name": "Solar Yesterday",
        "group": "log-group-daily",
        "order": 4,
        "width": "4",
        "height": "1",
        "label": "Solar Yesterday",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 580,
        "y": 380,
        "wires": []
    }
]
