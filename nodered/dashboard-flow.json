[
    {
        "id": "cv-tab",
        "type": "ui_tab",
        "name": "Campervan",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "cv-group-battery",
        "type": "ui_group",
        "name": "Battery",
        "tab": "cv-tab",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "cv-group-solar",
        "type": "ui_group",
        "name": "Solar",
        "tab": "cv-tab",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "cv-group-ac",
        "type": "ui_group",
        "name": "AC Loads",
        "tab": "cv-tab",
        "order": 3,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "cv-mqtt-broker",
        "type": "mqtt-broker",
        "name": "Cerbo MQTT",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered-dashboard",
        "usetls": false,
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "cv-soc-in",
        "type": "mqtt in",
        "name": "Battery SOC",
        "topic": "N/+/system/0/Dc/Battery/Soc",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 130,
        "y": 80,
        "wires": [["cv-soc-func"]]
    },
    {
        "id": "cv-soc-func",
        "type": "function",
        "name": "Extract value",
        "func": "msg.payload = msg.payload.value;\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 80,
        "wires": [["cv-soc-gauge", "cv-soc-chart"]]
    },
    {
        "id": "cv-soc-gauge",
        "type": "ui_gauge",
        "name": "Battery %",
        "group": "cv-group-battery",
        "order": 1,
        "width": "3",
        "height": "3",
        "gtype": "gage",
        "title": "Battery",
        "label": "%",
        "format": "{{value}}",
        "min": 0,
        "max": "100",
        "colors": ["#CA3838", "#E6E600", "#00B500"],
        "seg1": "25",
        "seg2": "75",
        "x": 530,
        "y": 60,
        "wires": []
    },
    {
        "id": "cv-soc-chart",
        "type": "ui_chart",
        "name": "Battery History",
        "group": "cv-group-battery",
        "order": 2,
        "width": "6",
        "height": "4",
        "label": "Battery %",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm",
        "interpolate": "linear",
        "nodata": "Waiting...",
        "dot": false,
        "ymin": "0",
        "ymax": "100",
        "removeOlder": "24",
        "removeOlderPoints": "",
        "removeOlderUnit": "3600",
        "cutout": 0,
        "useOneColor": true,
        "useUTC": false,
        "colors": ["#4682B4"],
        "outputs": 1,
        "useDifferentColor": false,
        "x": 550,
        "y": 100,
        "wires": [[]]
    },
    {
        "id": "cv-voltage-in",
        "type": "mqtt in",
        "name": "Battery Voltage",
        "topic": "N/+/system/0/Dc/Battery/Voltage",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 140,
        "y": 160,
        "wires": [["cv-voltage-func"]]
    },
    {
        "id": "cv-voltage-func",
        "type": "function",
        "name": "Extract value",
        "func": "msg.payload = parseFloat(msg.payload.value).toFixed(2);\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 160,
        "wires": [["cv-voltage-text"]]
    },
    {
        "id": "cv-voltage-text",
        "type": "ui_text",
        "name": "Voltage",
        "group": "cv-group-battery",
        "order": 3,
        "width": "3",
        "height": "1",
        "label": "Voltage",
        "format": "{{msg.payload}}V",
        "layout": "row-spread",
        "x": 530,
        "y": 160,
        "wires": []
    },
    {
        "id": "cv-solar-in",
        "type": "mqtt in",
        "name": "Solar Power",
        "topic": "N/+/system/0/Dc/Pv/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 130,
        "y": 260,
        "wires": [["cv-solar-func"]]
    },
    {
        "id": "cv-solar-func",
        "type": "function",
        "name": "Extract value",
        "func": "msg.payload = Math.round(msg.payload.value);\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 260,
        "wires": [["cv-solar-gauge", "cv-solar-chart"]]
    },
    {
        "id": "cv-solar-gauge",
        "type": "ui_gauge",
        "name": "Solar W",
        "group": "cv-group-solar",
        "order": 1,
        "width": "3",
        "height": "3",
        "gtype": "gage",
        "title": "Solar",
        "label": "W",
        "format": "{{value}}",
        "min": 0,
        "max": "3000",
        "colors": ["#555555", "#F5B800", "#00B500"],
        "seg1": "500",
        "seg2": "1500",
        "x": 530,
        "y": 240,
        "wires": []
    },
    {
        "id": "cv-solar-chart",
        "type": "ui_chart",
        "name": "Solar History",
        "group": "cv-group-solar",
        "order": 2,
        "width": "6",
        "height": "4",
        "label": "Solar Power (W)",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm",
        "interpolate": "linear",
        "nodata": "Waiting...",
        "dot": false,
        "ymin": "0",
        "ymax": "",
        "removeOlder": "24",
        "removeOlderPoints": "",
        "removeOlderUnit": "3600",
        "cutout": 0,
        "useOneColor": true,
        "useUTC": false,
        "colors": ["#F5B800"],
        "outputs": 1,
        "useDifferentColor": false,
        "x": 550,
        "y": 280,
        "wires": [[]]
    },
    {
        "id": "cv-acload-in",
        "type": "mqtt in",
        "name": "AC Load",
        "topic": "N/+/system/0/Ac/Consumption/L1/Power",
        "qos": "0",
        "datatype": "json",
        "broker": "cv-mqtt-broker",
        "x": 130,
        "y": 360,
        "wires": [["cv-acload-func"]]
    },
    {
        "id": "cv-acload-func",
        "type": "function",
        "name": "Extract value",
        "func": "msg.payload = Math.round(msg.payload.value);\nreturn msg;",
        "outputs": 1,
        "x": 330,
        "y": 360,
        "wires": [["cv-acload-text"]]
    },
    {
        "id": "cv-acload-text",
        "type": "ui_text",
        "name": "AC Load",
        "group": "cv-group-ac",
        "order": 1,
        "width": "3",
        "height": "1",
        "label": "AC Load",
        "format": "{{msg.payload}}W",
        "layout": "row-spread",
        "x": 530,
        "y": 360,
        "wires": []
    }
]
